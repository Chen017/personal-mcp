[Unit]
Description=Personal FastMCP Server - Notes & Web (SiYuan Notes + Firecrawl v2)
After=network.target docker.service

[Service]
Type=simple
User=YOUR_DEBIAN_USER
WorkingDirectory=/opt/personal-mcp
EnvironmentFile=/opt/personal-mcp/.env
ExecStart=/opt/personal-mcp/.venv/bin/python -m servers.notes_web
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
