mcp.example.com {
    log_skip /<SECRET_PATH_NOTES>/mcp
    log_skip /<SECRET_PATH_GITHUB>/mcp

    handle /<SECRET_PATH_NOTES>/mcp {
        rewrite * /mcp
        reverse_proxy 127.0.0.1:8101 {
            flush_interval -1
        }
    }
    handle /<SECRET_PATH_GITHUB>/mcp {
        rewrite * /mcp
        reverse_proxy 127.0.0.1:8102 {
            flush_interval -1
        }
    }
    handle {
        respond 404
    }
}

# IMPORTANT: In your public SiYuan Share site (e.g. notes.example.com) Caddy block, add:
#   header_up -X-MCP-Internal-Token
