# Server 1: Notes & Web (SiYuan Notes + Firecrawl v2)
NOTES_MCP_NAME=Personal Notes Web
NOTES_SITE_DOMAIN=notes.example.com
BLOG_SITE_DOMAIN=blog.example.com
NOTES_RPC_URL=http://127.0.0.1:8081/mcp
NOTES_INTERNAL_TOKEN=replace_with_same_64_hex_as_php_config
DEFAULT_NOTE_CHARS=16000

FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxx
FIRECRAWL_API_BASE_URL=https://api.firecrawl.dev/v2
DEFAULT_WEB_CHARS=16000
MAX_SINGLE_READ_CHARS=32000
WEB_CACHE_TTL_SECONDS=1800
WEB_CACHE_MAX_ENTRIES=32
CRAWL_SOFT_MAX_PAGES=20
BATCH_SOFT_MAX_URLS=15
EXTRACT_SOFT_MAX_URLS=10

# Server 2: GitHub Personal
GITHUB_PAT=github_pat_xxxxxxxxxxxxxxxx
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_DEFAULT_OWNER=your-github-username
GITHUB_ALLOWED_WRITE_OWNERS=your-github-username
DEFAULT_FILE_LINES=350
DEFAULT_FILE_CHARS=32000
DEFAULT_DIFF_CHARS=15000

# Reverse Proxy Random Capability Paths (generate with: openssl rand -hex 32)
SECRET_PATH_NOTES=replace_with_64_hex_chars_1
SECRET_PATH_GITHUB=replace_with_64_hex_chars_2
